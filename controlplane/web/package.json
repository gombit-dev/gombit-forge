{
  "name": "forge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Forge visual editor — the control plane's web UI (M2).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
